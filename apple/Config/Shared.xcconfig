KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(KEYCHAIN_GROUP_SUFFIX)

LEHRERMAPS_BUNDLE_ID = de.albertocabrera.LehrerMaps
LEHRERMAPS_WIDGET_BUNDLE_ID = de.albertocabrera.LehrerMaps.Widget
