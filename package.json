{
  "name": "lehrermaps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "dev:8090": "concurrently \"npm run build:watch\" \"npm run dev --prefix server\"",
    "build": "npm run build --prefix client",
    "build:watch": "npm run build --prefix client -- --watch",
    "test:smoke": "node scripts/lehrermaps-smoke.mjs",
    "test:pwa": "node scripts/lehrermaps-pwa-audit.mjs",
    "test:authorization": "node scripts/lehrermaps-authorization-e2e.mjs",
    "test:today-dashboard": "node scripts/lehrermaps-today-dashboard-api.mjs",
    "test:bug-checklist": "node scripts/lehrermaps-bug-checklist-api.mjs",
    "test:pending-sync": "node scripts/lehrermaps-pending-sync.mjs",
    "test:annual-planning": "node scripts/lehrermaps-annual-plan-api.mjs",
    "test:e2e:teaching": "node scripts/lehrermaps-teaching-e2e.mjs",
    "test:e2e:responsive": "node scripts/lehrermaps-responsive-e2e.mjs",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
