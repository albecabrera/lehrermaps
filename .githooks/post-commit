#!/bin/sh
set -eu

ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

echo "LehrerMaps: deploying committed static assets …"
bash scripts/deploy-static.sh

BRANCH=$(git branch --show-current)
REMOTE=${LEHRERMAPS_PUSH_REMOTE:-origin}

if [ -z "$BRANCH" ]; then
  echo "LehrerMaps: kein Branch erkannt, Push übersprungen."
  exit 0
fi

echo "LehrerMaps: pushe Commit nach ${REMOTE}/${BRANCH} …"
git push "$REMOTE" "$BRANCH"
